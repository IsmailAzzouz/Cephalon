{
  "name": "cephalon",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cephalon",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*",
        "examples/avatar-playground"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "examples/avatar-playground": {
      "name": "@cephalon/avatar-playground",
      "version": "1.0.0",
      "license": "MIT"
    },
    "node_modules/@cephalon/avatar": {
      "resolved": "packages/avatar",
      "link": true
    },
    "node_modules/@cephalon/avatar-playground": {
      "resolved": "examples/avatar-playground",
      "link": true
    },
    "node_modules/@cephalon/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "packages/avatar": {
      "name": "@cephalon/avatar",
      "version": "1.0.0",
      "license": "MIT"
    },
    "packages/contracts": {
      "name": "@cephalon/contracts",
      "version": "1.0.0",
      "license": "MIT"
    }
  }
}
